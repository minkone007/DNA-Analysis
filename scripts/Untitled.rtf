def generate(person_cfg, verbose=True):\
    name        = person_cfg["name"]\
    results_dir = ROOT_DIR / person_cfg["results_dir"]\
    synth_path  = results_dir / "synthesis.json"\
\
    if not synth_path.exists():\
        if verbose: print(f"  WARN: synthesis.json not found for \{name\}")\
        return None\
\
    synthesis = json.load(open(synth_path))\
    out = render(name, synthesis, results_dir)\
    if verbose: print(f"  OK   Narrative \uc0\u8594  \{out.name\}")\
    return out\
\
def main():\
    parser = argparse.ArgumentParser()\
    grp = parser.add_mutually_exclusive_group(required=True)\
    grp.add_argument("--person")\
    grp.add_argument("--all", action="store_true")\
    args = parser.parse_args()\
\
    cfg    = json.load(open(CONFIG))\
    people = cfg["people"]\
    targets = people if args.all else [\
        p for p in people if p["name"].lower() == args.person.lower()\
    ]\
    if not targets:\
        print("ERROR: person not found"); sys.exit(1)\
\
    for pcfg in targets:\
        print(f"\\n--- Narrative: \{pcfg['name']\} ---")\
        out = generate(pcfg)\
        if out: print(f"  Written: \{out\}")\
\
if __name__ == "__main__":\
    main()\
